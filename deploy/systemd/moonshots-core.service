[Unit]
Description=Moonshots core (dashboard, scheduler, approvals)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/moonshots/core
Environment=MOONSHOTS_ROOT=/srv/moonshots
Environment=MOONSHOTS_HOST=127.0.0.1
Environment=MOONSHOTS_PORT=8100
Environment=MOONSHOTS_BASE_PATH=/ops
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/moonshots/core/.venv/bin/python -m moonshots
Restart=always
RestartSec=5
MemoryMax=400M
Nice=5

[Install]
WantedBy=default.target
